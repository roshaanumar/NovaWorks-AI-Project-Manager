+
+/* ---------- login ---------- */
+function renderLogin() {
+  $app.innerHTML = `
+  <div class="min-h-screen flex items-center justify-center px-4 py-10">
+    <div class="w-full max-w-md">
+      <div class="flex items-center gap-3 mb-6 justify-center">
+        <span class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary to-tertiary-container flex items-center justify-center text-on-primary">${icon('hub','text-[26px]')}</span>
