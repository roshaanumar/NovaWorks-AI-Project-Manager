+        <label class="block font-label-md text-label-md mb-1">Password</label>
+        <input id="pw" type="password" autocomplete="current-password" class="w-full mb-4 rounded-lg border border-outline-variant bg-surface px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary"/>
+        <button id="lbtn" class="w-full py-2.5 rounded-lg bg-primary text-on-primary font-headline-sm text-headline-sm flex items-center justify-center gap-2 active:scale-[0.98] transition">Log in</button>
+      `, 'p-6')}
+      <div class="mt-4 font-caption-code text-caption-code text-on-surface-variant text-center">Demo accounts (password <b>Demo123!</b>) — tap to fill</div>
+      <div class="mt-2 flex flex-wrap gap-2 justify-center">${DEMO.map(([k,l]) => `<button data-u="${k}" class="demo px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant hover:text-primary font-label-sm text-label-sm">${l}</button>`).join('')}</div>
