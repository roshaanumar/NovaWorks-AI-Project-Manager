+    </nav>
+  </header>
+  <main class="max-w-3xl mx-auto px-4 py-5 pb-16">${inner}</main>`;
+  document.getElementById('logout').onclick = async () => { await api('/logout', {method:'POST'}).catch(()=>{}); me = null; location.hash = '#/login'; route(); };
+}
+const chip = (ic, txt, cls='bg-surface-container text-on-surface-variant') => `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-label-sm text-label-sm ${cls}">${icon(ic,'text-[14px]')}${txt}</span>`;
+const card = (inner, extra='') => `<div class="bg-surface-container-lowest rounded-xl p-4 shadow-sm ${extra}">${inner}</div>`;
