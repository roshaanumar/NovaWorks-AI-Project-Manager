diff --git a/Backend/public/index.html b/Backend/public/index.html
new file mode 100644
index 0000000..4a1f569
--- /dev/null
+++ b/Backend/public/index.html
@@ -0,0 +1,265 @@
+<!DOCTYPE html>
+<html lang="en"><head><meta charset="utf-8"/>
+<meta name="viewport" content="width=device-width, initial-scale=1"/>
+<title>NovaWorks AI Project Manager</title>
+<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet"/>
+<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
+<script src="https://cdn.tailwindcss.com"></script>
+<script src="/tw-config.js"></script>
+<style>.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400}::-webkit-scrollbar{display:none}</style>
+</head>
+<body class="bg-surface font-body-md text-body-md text-on-surface antialiased min-h-screen">
+<div id="app"></div>
+<script>
+const $app = document.getElementById('app');
+let me = null, busy = false;
+const DEMO = [['admin','Admin'],['ayesha','Ayesha (PM)'],['bilal','Bilal (PM)'],['hina','Hina (PM)'],['ali','Ali'],['hamza','Hamza'],['sara','Sara'],['usman','Usman'],['zain','Zain'],['maryam','Maryam']];
+const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
+const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const fmtDate = d => { if (!d) return '—'; const [y,m,x] = d.split('-').map(Number); return `${x} ${MON[m-1]} ${y}`; };
+const fmtH = h => `${Math.round(h*10)/10}h`;
+const icon = (n, c='') => `<span class="material-symbols-outlined ${c}">${n}</span>`;
+const initials = n => n.split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase();
+const spinner = icon('progress_activity', 'animate-spin text-[18px]');
+
+async function api(path, opts = {}) {
+  const r = await fetch('/api' + path, { credentials: 'same-origin', headers: {'Content-Type':'application/json'}, ...opts, body: opts.body ? JSON.stringify(opts.body) : undefined });
+  const data = await r.json().catch(() => ({}));
+  if (!r.ok) { const e = new Error(data.error || r.statusText); e.status = r.status; e.data = data; throw e; }
+  return data;
+}
+
+/* ---------- shell ---------- */
+function shell(inner, active) {
+  const agent = me.role === 'AGENT';
+  const tabs = [
+    ...(agent ? [['tasks','My Tasks','task_alt']] : []),
+    ['projects', agent ? 'Related projects' : 'Projects', 'folder_open'],
+    ['team','Team','groups'],
+    ...(me.role === 'ADMIN' ? [['transcript','Create from Transcript','auto_awesome']] : []),
+  ];
+  $app.innerHTML = `
+  <header class="sticky top-0 z-40 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
+    <div class="max-w-3xl mx-auto h-16 px-4 flex items-center justify-between gap-3">
+      <a href="#/" class="flex items-center gap-2 min-w-0">
+        <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-tertiary-container flex items-center justify-center text-on-primary">${icon('hub','text-[20px]')}</span>
+        <span class="font-headline-sm text-headline-sm truncate">NovaWorks <span class="text-primary">AI</span></span>
+      </a>
+      <div class="flex items-center gap-3">
+        <div class="text-right leading-tight hidden sm:block"><div class="font-label-md text-label-md font-semibold">${esc(me.name)}</div><div class="font-caption-code text-caption-code text-on-surface-variant">${esc(me.role)}</div></div>
+        <div class="w-8 h-8 rounded-full bg-primary-fixed text-on-primary-fixed flex items-center justify-center font-label-sm text-label-sm">${esc(initials(me.name))}</div>
+        <button id="logout" aria-label="Log out" class="w-10 h-10 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary">${icon('logout','text-[22px]')}</button>
+      </div>
+    </div>
+    <nav class="max-w-3xl mx-auto px-4 pb-2 flex gap-2 overflow-x-auto">
