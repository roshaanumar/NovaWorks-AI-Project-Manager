# Choose ONE provider and set its key (provider is auto-detected from whichever key exists)
LLM_PROVIDER=gemini            # gemini | anthropic | openai
GEMINI_API_KEY=your-key-here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: gemini-2.0-flash / claude-sonnet-5-5 / gpt-4o-mini)
LLM_MODEL=
SESSION_SECRET=change-me
PORT=3000
DB_PATH=./data/novaworks.db
